# Copy to .env and fill in. Never commit .env.

# Used by learn_crewai.py and the workplace backend.
# OPENAI_MODEL is the default for agents without their own model. A local
# Ollama model also works here, e.g. OPENAI_MODEL=ollama/qwen2.5:7b
# (no OpenAI key is needed if every agent uses a local model).
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Optional: enables the "web_search" tool for agents created in the UI
# SERPER_API_KEY=your-serper-key-here

# Optional backend overrides (defaults shown)
# WORKPLACE_DATA_DIR=./data
# WORKPLACE_RUNS_DIR=./runs
# WORKPLACE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# WORKPLACE_ALLOWED_MODELS=["gpt-4o-mini","gpt-4o","gpt-4.1-mini","gpt-4.1"]
# Installed Ollama models are offered automatically; set to empty to disable them.
# WORKPLACE_OLLAMA_BASE_URL=http://localhost:11434
# WORKPLACE_MAX_CUSTOM_PARTICIPANTS=5

# Keeps CrewAI from asking an interactive tracing question during background runs
CREWAI_TRACING_ENABLED=false
